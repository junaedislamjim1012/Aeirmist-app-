rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL SAFETY NET - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // -- PRIMITIVES & SECURITY HELPERS --
    // ==========================================
    function isSignedIn() { 
      return request.auth != null; 
    }

    // Admin Security Helper - Validates Privileged Custom Claims, Trusted Admin Document, or Verified Owner Identity
    function isOwnerAccount() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'junaedislamjim180@gmail.com' ||
        request.auth.token.email == 'gateway_node@aeirmist.social'
      );
    }

    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['owner', 'admin', 'super_admin', 'administrator', 'moderator', 'support', 'marketplace_moderator']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isOwnerAccount()
      );
    }

    function isOwner(userId) { 
      return request.auth != null && request.auth.uid == userId; 
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }
    
    // -- RELATIONAL HELPERS --
    function isProfileOwnerRead(profileId) {
      return isSignedIn() && (
        profileId == 'profile_' + request.auth.uid ||
        profileId.startsWith('profile_' + request.auth.uid) ||
        (exists(/databases/$(database)/documents/profiles/$(profileId)) && 
         (get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/profiles/$(profileId)).data.uid == request.auth.uid))
      );
    }

    function isProfileOwnerWrite(profileId) {
      return isSignedIn() && (
        profileId == 'profile_' + request.auth.uid ||
        profileId.startsWith('profile_' + request.auth.uid) ||
        (exists(/databases/$(database)/documents/profiles/$(profileId)) && 
         (get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/profiles/$(profileId)).data.uid == request.auth.uid)) ||
        (existsAfter(/databases/$(database)/documents/profiles/$(profileId)) && 
         (getAfter(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid ||
          getAfter(/databases/$(database)/documents/profiles/$(profileId)).data.uid == request.auth.uid))
      );
    }

    function isFollowInteractionWrite(profileId) {
      return isSignedIn() && 
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['social', 'followersCount']) &&
             (resource.data.social == null || request.resource.data.social.diff(resource.data.social).affectedKeys().hasOnly(['followers']));
    }

    // Conversation Participant Authorization Helper
    function isConversationParticipant(conv) {
      return isSignedIn() && conv != null && (
        (conv.keys().hasAll(['participants']) && request.auth.uid in conv.participants) ||
        (conv.keys().hasAll(['profileIds']) && (
          request.auth.uid in conv.profileIds ||
          ('profile_' + request.auth.uid) in conv.profileIds
        )) ||
        (conv.keys().hasAll(['otherParticipantId']) && (
          conv.otherParticipantId == request.auth.uid ||
          conv.otherParticipantId == 'profile_' + request.auth.uid
        )) ||
        (conv.keys().hasAll(['otherParticipantUid']) && conv.otherParticipantUid == request.auth.uid) ||
        (conv.keys().hasAll(['ownerUid']) && conv.ownerUid == request.auth.uid)
      );
    }

    // Call Participant Helper
    function isCallParticipant(callDoc) {
      return isSignedIn() && callDoc != null && (
        request.auth.uid == callDoc.callerUid ||
        request.auth.uid == callDoc.receiverUid ||
        request.auth.uid == callDoc.initiatorId ||
        request.auth.uid == callDoc.targetId ||
        (callDoc.keys().hasAll(['participants']) && request.auth.uid in callDoc.participants)
      );
    }

    // ==========================================
    // -- COLLECTION RULES --
    // ==========================================
    
    // 1. USERS: Read restricted to authenticated; create/update/delete restricted to user owner
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid);
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // 2. PROFILES: Read public/auth; write restricted to profile owner or follower counter; vault & settings strictly owner only
    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid || 
        request.resource.data.uid == request.auth.uid ||
        profileId == 'profile_' + request.auth.uid
      );
      allow update: if isSignedIn() && (
        isProfileOwnerWrite(profileId) || 
        isFollowInteractionWrite(profileId) || 
        isAdmin()
      );
      allow delete: if isSignedIn() && (isProfileOwnerWrite(profileId) || isAdmin());
      
      match /vault/{vaultDoc} {
        allow read, write: if isSignedIn() && isProfileOwnerWrite(profileId);
      }

      match /settings/{settingsDoc} {
        allow read, write: if isSignedIn() && isProfileOwnerWrite(profileId);
      }
    }

    // 3. ADMINS & AUTHORIZATION
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /role_policies/{policyId} {
      allow read, write: if isAdmin();
    }

    // 4. USERNAME INDEX: Unique registry, owned by claimant
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        (resource != null && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid)) || 
        isAdmin()
      );
    }

    // 5. POSTS: Public read; create bound to authorUid; update/delete by author or admin
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likesCount', 'bookmarks', 'bookmarksCount', 'sharesCount', 'commentsCount']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && (
          request.resource.data.authorUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );
        allow update, delete: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 6. POST INSIGHTS & ANALYTICS
    match /post_insights/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn(); 
    }

    match /post_views/{viewId} {
      allow create: if true;
      allow read: if isSignedIn() && (
        resource == null || 
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorUid == request.auth.uid
      );
    }

    // 7. FOLLOW REQUESTS: Sender and receiver access only
    match /follow_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromProfileId == 'profile_' + request.auth.uid ||
        resource.data.toProfileId == 'profile_' + request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromProfileId == 'profile_' + request.auth.uid ||
        resource.data.toProfileId == 'profile_' + request.auth.uid ||
        isAdmin()
      );
    }

    // 8. CONVERSATIONS & MESSAGES: Strict participant-only authorization
    match /conversations/{conversationId} {
      allow list: if isSignedIn();
      allow get: if isConversationParticipant(resource.data) || isAdmin();
      allow create: if isConversationParticipant(request.resource.data) || isAdmin();
      allow update: if (isConversationParticipant(resource.data) || isConversationParticipant(request.resource.data)) || isAdmin();
      allow delete: if isConversationParticipant(resource.data) || isAdmin();

      match /messages/{messageId} {
        allow read: if isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) || isAdmin();
        allow create: if (
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) ||
          isConversationParticipant(getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data)
        ) && (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.senderId == 'profile_' + request.auth.uid ||
          request.resource.data.senderUid == request.auth.uid ||
          request.resource.data.senderId.startsWith(request.auth.uid)
        );
        allow update, delete: if (
          resource.data.senderId == request.auth.uid ||
          resource.data.senderId == 'profile_' + request.auth.uid ||
          resource.data.senderUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 9. CHAT SETTINGS (Personal): Owner only
    match /chat_settings/{docId} {
      allow read, write: if isSignedIn() && (
        docId.startsWith(request.auth.uid) ||
        docId.startsWith('profile_' + request.auth.uid) ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid))
      );
    }
    
    // 10. SHARED CHAT SETTINGS: Conversation participants only
    match /shared_chat_settings/{chatId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        isConversationParticipant(get(/databases/$(database)/documents/conversations/$(chatId)).data) ||
        isAdmin()
      );
    }

    // 11. VAULT FOLDERS: Owner only
    match /vault_folders/{folderId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // 12. CHAT NICKNAMES: Owner only
    match /chat_nickname/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 13. VIDEOS & STORIES: Author only write/delete; viewers update reactions
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'views', 'sharesCount']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().authorUid == request.auth.uid || isAdmin());
    }
    
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['viewers', 'reactions']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().authorUid == request.auth.uid || isAdmin());
    }

    // 14. NOTIFICATIONS: Recipient only read/update/delete
    match /notifications/{notifId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.targetUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        resource.data.targetId == request.auth.uid ||
        resource.data.targetId == 'profile_' + request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.targetUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        resource.data.targetId == request.auth.uid ||
        resource.data.targetId == 'profile_' + request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        isAdmin()
      );
    }

    // 15. CALLS & CANDIDATES: Strict participant-only authorization
    match /calls/{callId} {
      allow list: if isSignedIn();
      allow get: if isCallParticipant(resource.data) || isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.callerUid == request.auth.uid ||
        request.resource.data.initiatorId == request.auth.uid ||
        (request.resource.data.keys().hasAll(['participants']) && request.auth.uid in request.resource.data.participants)
      );
      allow update: if isCallParticipant(resource.data) || isAdmin();
      allow delete: if (resource.data.initiatorId == request.auth.uid || resource.data.callerUid == request.auth.uid || isAdmin());

      match /candidates/{candId} {
        allow read, write: if isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data) || isAdmin();
      }
    }

    // 16. CALL HISTORY: Participant only
    match /callHistory/{recordId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
    }
    
    // 17. ACCOUNTS: Owner only
    match /accounts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    
    // 18. NOTES: Public read; author only update/delete
    match /notes/{noteId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.authorId == 'profile_' + request.auth.uid
      );
      allow update: if isSignedIn() && (
        existing().authorUid == request.auth.uid ||
        existing().authorId == request.auth.uid ||
        existing().authorId == 'profile_' + request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['seenBy', 'reactions']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        existing().authorUid == request.auth.uid || 
        existing().authorId == request.auth.uid || 
        existing().authorId == 'profile_' + request.auth.uid ||
        isAdmin()
      );
    }
    
    // 19. HIGHLIGHTS: Public read; author only
    match /highlights/{highlightId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // 20. SONGS: Public read; admin write
    match /songs/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 21. NGL MESSAGES: Recipient only read & manage; signed in send
    match /ngl_messages/{msgId} {
      allow get, list: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientProfileId == '');
      allow create: if isSignedIn() && 
        incoming().status == 'unread' && 
        incoming().content.size() <= 300 &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && (existing().recipientUid == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'storyReplyId', 'repliedAt']);
      allow delete: if isSignedIn() && (existing().recipientUid == request.auth.uid || isAdmin());
    }

    // 22. TYPING INDICATORS: Strictly conversation participant / owner only
    match /typing_indicators/{indicatorId} {
      allow read, write: if isSignedIn() && (
        indicatorId.contains(request.auth.uid) ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid))
      );
    }

    // 23. MARKETPLACE STORES: Public read; owner only write
    match /stores/{storeId} {
      allow read: if resource == null || 
                     resource.data.status == 'active' || 
                     !resource.data.keys().hasAll(['status']) ||
                     (isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.ownerUid == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || request.resource.data.ownerUid == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // 24. MARKETPLACE PRODUCTS: Public read; seller/owner only write
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerUid == request.auth.uid || 
        request.resource.data.sellerId == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid || 
        isAdmin()
      );
    }

    // 25. MARKETPLACE SERVICES: Public read; seller/owner only write
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerUid == request.auth.uid || 
        request.resource.data.sellerId == request.auth.uid || 
        request.resource.data.ownerUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid || 
        isAdmin()
      );
    }

    // 26. MARKETPLACE STORE POSTS: Public read; store owner only write
    match /store_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.sellerUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
    }

    // 27. MARKETPLACE STORE CHATS: Buyer, seller, or participants only
    match /store_chats/{chatId} {
      allow get: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (resource.data.keys().hasAll(['participants']) && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.buyerUid == request.auth.uid ||
        request.resource.data.sellerUid == request.auth.uid ||
        (request.resource.data.keys().hasAll(['participants']) && request.auth.uid in request.resource.data.participants) ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (resource.data.keys().hasAll(['participants']) && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.buyerUid == request.auth.uid ||
          get(/databases/$(database)/documents/store_chats/$(chatId)).data.sellerUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/store_chats/$(chatId)).data.participants ||
          isAdmin()
        );
      }
    }

    // 28. FEED COMMENTS: Public read; author only write
    match /feed_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // 29. MARKETPLACE STORE REVIEWS: Public read; author only write
    match /store_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // 30. MARKETPLACE SAVED ITEMS: User owner only
    match /saved_items/{itemId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 31. BILLING TRANSACTIONS: User owner or admin only
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 32. ACTIVITIES: User owner only
    match /activities/{activityId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 33. SOUND LIBRARY: Public read; uploader or admin write
    match /sound_library/{trackId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (resource.data.uploaderUid == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['usageCount']))
      );
      allow delete: if isSignedIn() && (resource.data.uploaderUid == request.auth.uid || isAdmin());
    }

    // 34. MARKETPLACE ORDERS: Buyer, seller, or admin only
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 35. LOGIN SESSIONS: User owner or admin only
    match /login_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 36. CONTENT REPORTS: Reporter or admin only
    match /reports/{reportId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource != null && (
          (resource.data.keys().hasAll(['reporterUid']) && resource.data.reporterUid == request.auth.uid) ||
          (resource.data.keys().hasAll(['reporterId']) && resource.data.reporterId == request.auth.uid)
        )
      );
      allow create: if isSignedIn()
        && (
          (request.resource.data.keys().hasAll(['reporterUid']) && request.resource.data.reporterUid == request.auth.uid) ||
          (request.resource.data.keys().hasAll(['reporterId']) && request.resource.data.reporterId == request.auth.uid)
        )
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 37. SYSTEM CONFIGURATION: Public read; admin write
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 38. GROUPS & PAGES: Owner/creator only write
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid ||
        isAdmin()
      );
    }
    
    match /pages/{pageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid ||
        isAdmin()
      );
    }

    // 39. APPEALS & MODERATION: Appellant or admin only
    match /appeals/{appealId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 40. MARKETPLACE ITEMS: Public read; seller/owner only write
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.sellerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
    }

    // 41. LOGS & EVENTS: Owner or admin only
    match /login_history/{historyId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /processed_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /transaction_logs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 42. SUPPORT REPORTS: Reporter or admin only
    match /supportReports/{reportId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource != null && (
          (resource.data.keys().hasAll(['userUid']) && resource.data.userUid == request.auth.uid) ||
          (resource.data.keys().hasAll(['userId']) && resource.data.userId == request.auth.uid)
        )
      );
      allow create: if isSignedIn()
        && (
          (request.resource.data.keys().hasAll(['userUid']) && request.resource.data.userUid == request.auth.uid) ||
          (request.resource.data.keys().hasAll(['userId']) && request.resource.data.userId == request.auth.uid)
        )
        && (request.resource.data.status == 'Pending' || request.resource.data.status == 'pending' || !request.resource.data.keys().hasAll(['status']));
      allow update: if isAdmin() || (
        isSignedIn() && resource != null && (
          (resource.data.keys().hasAll(['userUid']) && resource.data.userUid == request.auth.uid) ||
          (resource.data.keys().hasAll(['userId']) && resource.data.userId == request.auth.uid)
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'priority', 'adminReply', 'closedAt', 'userUid', 'userId'])
      );
      allow delete: if isAdmin();
    }
  }
}
