rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // -- PRIMITIVES --
    function isSignedIn() { return request.auth != null; }
    
    // -- PATHS --
    
    // Allow any signed-in user to upload and read across standard user/media folders
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
    
    match /notes/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Catch-all fallback for any other storage paths
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}
