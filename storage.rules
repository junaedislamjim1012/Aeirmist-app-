rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // -- AUTH & IDENTITY HELPERS --
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -- CONTENT VALIDATION HELPERS --
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 20 * 1024 * 1024; // Max 20MB
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 100 * 1024 * 1024; // Max 100MB
    }

    function isValidAudio() {
      return request.resource.contentType.matches('audio/.*')
        && request.resource.size < 50 * 1024 * 1024; // Max 50MB
    }

    function isValidMedia() {
      return isValidImage() || isValidVideo() || isValidAudio();
    }

    // -- USER ISOLATED PATHS --
    
    // User root uploads (avatars, covers, wallpapers, stores, products under users/{uid}/...)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }
    
    // Specific avatar and profile picture paths
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }
    
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }
    
    // Posts & Reels media uploaded by user
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidVideo();
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    match /notes/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia();
    }

    // Private Vault files — owner-only read AND write
    match /vault/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Chat attachments — authenticated participants can read/write with media validation
    match /chats/{chatId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidMedia();
    }

    // Report/support attachments — user-scoped, owner writes, admin reads
    match /reports/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
    }

    match /supportTickets/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
    }

    match /supportReports/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
    }

    // Sound library — user-scoped audio and cover art
    match /sound-library/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidAudio();
    }

    match /sound-library-art/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Global wallpapers — user-scoped
    match /wallpapers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
